DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chatbot_tcc
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
TRIAGE_MODEL=claude-opus-5
CHROMA_PERSIST_DIR=./chroma_data
FRONTEND_URL=http://localhost:5173
DATA_ENCRYPTION_KEY=
DATA_RETENTION_DAYS=90
WHATSAPP_ACCESS_TOKEN=
# Segredo do app (Configurações do app > Básico) e senha do desafio do
# webhook (qualquer texto longo; o mesmo vai no painel da Meta)
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v25.0
# Endereço fixo do túnel (sem https://); só /webhook/ passa por ele
PUBLIC_WEBHOOK_HOST=
# Segundos de espera antes de responder no WhatsApp
REPLY_DEBOUNCE_SECONDS=6
# E-mail que envia os alertas (ex.: Gmail com senha de app)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Login do painel com Google: Client ID do tipo "Web application" e
# e-mails convidados, separados por vírgula (vazio = ninguém entra)
GOOGLE_CLIENT_ID=
# Agenda: segredo do mesmo cliente OAuth (a janela de permissão da tela
# Agenda) e o fuso do horário de atendimento
GOOGLE_CLIENT_SECRET=
AGENDA_TIMEZONE=America/Sao_Paulo
ALLOWED_EMAILS=
SESSION_DAYS=7
# true em produção (HTTPS)
SESSION_COOKIE_SECURE=false
