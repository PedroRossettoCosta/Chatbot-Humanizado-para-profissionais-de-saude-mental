# Endereço da API visto pelo navegador. Padrão: /api, repassado pelo
# proxy do Vite para o backend. Mantenha no mesmo endereço do painel:
# senão o cookie de sessão do login não é enviado.
VITE_API_URL=/api
# Para onde o proxy do Vite repassa /api. Padrão: http://127.0.0.1:8000
# VITE_API_TARGET=http://127.0.0.1:8000
